PORT=3000

# --- Admin login (required to use /admin) ---
ADMIN_USERNAME=
# at least 12 characters
ADMIN_PASSWORD=
# at least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Database (Supabase). Leave both empty to use local files while testing. ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Maps ---
# By default the site uses FREE OpenStreetMap (place search, map pins, road distance) - nothing to set up.
# Optional upgrade: add Google keys below to use Google Maps instead.
# MAPS_PROVIDER=off          turns the map off (simple city list only)
# OSRM_URL=                  your own OSRM routing server (default: the free public one)
# --- Google Maps (optional) ---
# Browser key: Maps JavaScript API + Places API (New). Restrict it to your website address.
GOOGLE_MAPS_API_KEY=
# Server key: Routes API. Keep secret; do NOT restrict by website address.
GOOGLE_MAPS_SERVER_KEY=
# Optional custom map style id from Google Cloud (leave empty to use the default)
GOOGLE_MAPS_MAP_ID=

# --- WhatsApp manager alerts (optional) ---
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
CITY_DRIVE_MANAGER_PHONE=
WHATSAPP_TEMPLATE_NAME=city_drive_booking_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
